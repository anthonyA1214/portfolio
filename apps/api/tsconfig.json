{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["node", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "./**/*.ts",
    "../src/worker-configuration.d.ts" // output of `wrangler types`
  ]
}
