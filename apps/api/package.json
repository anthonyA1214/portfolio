{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:auth": "npm rebuild better-sqlite3 && npx auth@latest generate --config ./better-auth.config.ts",
    "generate:spec": "npx tsx ./scripts/generate-spec.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "list": "wrangler d1 migrations list portfolio_db --local",
    "list:prod": "wrangler d1 migrations list portfolio_db --remote",
    "apply:local": "wrangler d1 migrations apply portfolio_db --local",
    "apply:prod": "wrangler d1 migrations apply portfolio_db --remote",
    "deploy": "wrangler deploy --minify"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@scalar/hono-api-reference": "0.10.20",
    "better-auth": "1.6.22",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.12.23",
    "slugify": "^1.6.9",
    "stoker": "^2.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.12",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "better-sqlite3": "12.10.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "catalog:",
    "vitest": "^4.1.0",
    "wrangler": "catalog:"
  }
}
