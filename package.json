{
  "name": "portfolio",
  "version": "0.0.1",
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.10.12",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.3",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=api",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4",
    "@types/node": "25.9.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "^9",
    "lucide-react": "1.45.0",
    "motion": "13.2.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "typescript": "~6",
    "wrangler": "4.131.1",
    "zod": "^4.6.2"
  }
